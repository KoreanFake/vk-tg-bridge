# ===== ВКонтакте =====
# Токен сообщества с правами: сообщения сообщества (messages), фото, документы
VK_TOKEN=замените_на_токен_сообщества
# Числовой ID сообщества (без минуса), виден в Управление → Работа с API
VK_GROUP_ID=123456789
# Версия API ВК (фиксируем явно)
VK_API_VERSION=5.199

# ===== Telegram =====
# Токен бота от @BotFather
TG_TOKEN=замените_на_токен_бота
# ID закрытой супергруппы с темами (отрицательное число, например -1001234567890)
TG_GROUP_ID=-1001234567890
# Белый список Telegram ID сотрудников, через запятую
TG_ALLOWED_USER_IDS=111111111,222222222
# ID администраторов (подмножество whitelist) для команд /stats, /health, /status; можно оставить пустым = все из whitelist
TG_ADMIN_IDS=

# ===== Поведение =====
# Рабочие часы для напоминаний (часовой пояс сервера), формат ЧЧ:ММ-ЧЧ:ММ; пусто = круглосуточно
WORK_HOURS=09:00-21:00
# Интервалы напоминаний о необработанных обращениях, минуты, через запятую
REMINDER_INTERVALS_MIN=15,30
# Маскировать телефоны и адреса в сообщениях, пересылаемых в Telegram (true/false)
MASK_PERSONAL_DATA=false
# Не отправлять клиентам никаких автоматических сообщений (защита, рекомендуется true)
DISABLE_AUTOCLIENT_MESSAGES=true

# ===== Хранилище =====
DB_PATH=/data/bridge.db
LOG_LEVEL=INFO

# Название вашего сообщества/бренда (показывается в приветствии бота)
BRAND_NAME=Моя компания
